# ---------------------------------------------------------------------------
# Кондитерский Рай — переменные окружения PWA
# Скопируйте файл в .env.local и подставьте свои значения.
# ---------------------------------------------------------------------------

# Базовый путь сборки для GitHub Pages.
# В CI выставляется автоматически как "/<имя-репозитория>/".
# Для кастомного домена или локального превью корня сайта: "/"
VITE_BASE_PATH=/candys-paradise/

# Адрес API приёма заказов (заглушка apps/api).
# ПУСТО -> приложение работает в демо-режиме: заказ сохраняется на устройстве,
# отправка в Telegram имитируется (см. src/services/ordersService.ts).
# Для реальной отправки: /api/send-order (Vite проксирует на http://localhost:8787)
VITE_ORDER_API_URL=
