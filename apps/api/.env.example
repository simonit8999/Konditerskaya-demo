# ---------------------------------------------------------------------------
# API «Кондитерский Рай» — переменные окружения
# Скопируйте в apps/api/.env (файл в .gitignore, в репозиторий не попадает).
# ---------------------------------------------------------------------------

# Токен бота из @BotFather. Без него API работает в режиме log (печатает заказ в консоль).
TELEGRAM_BOT_TOKEN=

# ID чата/канала кондитера. Узнать можно через https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Порт HTTP-сервера (Vite проксирует /api на 8787)
PORT=8787

# CORS: "*" для локальной разработки, на проде укажите домен витрины
ALLOWED_ORIGIN=*
